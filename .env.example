# ===== finance-tracker Konfiguration =====
# Kopieren nach .env und anpassen. NIEMALS echte Werte committen!

# Datenbank (SQLite default; PostgreSQL via Connection-String, z.B. postgresql+psycopg://user:pw@host/db)
DATABASE_URL=sqlite:///./data/finance.db

# Log-Level (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO

# Banken für automatischen Sync, kommagetrennt (z.B. "comdirect,dkb"; "mock" = Demo-Daten)
BANKS=mock

# TAN-Modus: interactive (CLI-Prompt) | mock (Nur für Entwicklung/Demo!)
TAN_MODE=interactive

# Wie viele Tage rückwirkend beim Sync abgerufen werden
SYNC_DAYS_BACK=90

# Tägliche Sync-Uhrzeit (Stunde, 0-23)
SYNC_CRON_HOUR=6

# ---- Bank-Zugangsdaten ----
# EMPFOHLEN: System-Keyring (python -m app.fints_credentials set <bank>) — NICHT hier eintragen!
# Fallback für headless-Umgebungen (Container/CI): Umgebungsvariablen.
#  <BANK> = COMDIRECT | DKB
FT_COMDIRECT_BLZ=
FT_COMDIRECT_LOGIN=
FT_COMDIRECT_PIN=
FT_COMDIRECT_URL=https://fints.comdirect.de/fints/FinTS3Portals
FT_DKB_BLZ=30050553
FT_DKB_LOGIN=
FT_DKB_PIN=
FT_DKB_URL=https://banking-dkb.s-fints-pt-fsn.de/fints30