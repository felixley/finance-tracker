# ===== finance-tracker Konfiguration =====
# Kopieren nach .env und anpassen. NIEMALS echte Werte committen!

# Datenbank (SQLite default; PostgreSQL via Connection-String, z.B. postgresql+psycopg://user:pw@host/db)
DATABASE_URL=sqlite:///./data/finance.db

# Log-Level (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO

# Banken für automatischen Sync, kommagetrennt (z.B. "comdirect,dkb"; "mock" = Demo-Daten)
BANKS=mock

# TAN-Modus: interactive (CLI-Prompt) | mock (Nur für Entwicklung/Demo!)
TAN_MODE=interactive

# Wie viele Tage rückwirkend beim Sync abgerufen werden
SYNC_DAYS_BACK=90

# Tägliche Sync-Uhrzeit (Stunde, 0-23)
SYNC_CRON_HOUR=6

# ---- Bank-Zugangsdaten ----
# EMPFOHLEN: verschlüsselte File-Ablage (python -m app.fints_credentials set <bank>)
# — NICHT hier eintragen!  Fallback für headless-Umgebungen (Container/CI):
# Umgebungsvariablen — aber NUR wenn ALLOW_INSECURE_ENV_CREDS=1 gesetzt ist
# (Klartext-PINs in Env = bewusstes Risiko).
#  <BANK> = COMDIRECT | DKB
FT_COMDIRECT_BLZ=20041133
FT_COMDIRECT_LOGIN=
FT_COMDIRECT_PIN=
# FinTS/HBCI-Endpunkt (comdirect: fints.comdirect.de/fints/hbci)
FT_COMDIRECT_URL=https://fints.comdirect.de/fints/hbci
# HKTAN-Sicherheitsfunktion (optional; Default je Bank aus app/banks/<bank>.py)
FT_COMDIRECT_TAN_MECHANISM=902
# Bei der Bank registrierte Produkt-ID (optional; sonst Default des Projekts)
FT_COMDIRECT_PRODUCT_ID=
FT_DKB_BLZ=12030000
FT_DKB_LOGIN=
FT_DKB_PIN=
# DKB: neue FinTS-URL seit 25.11.2024
FT_DKB_URL=https://fints.dkb.de/fints
FT_DKB_TAN_MECHANISM=940
FT_DKB_PRODUCT_ID=